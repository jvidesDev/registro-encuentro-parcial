<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="Default.aspx.cs" Inherits="RegistroEncuentroParcial._Default" %>
<!DOCTYPE html><html lang="es"><head runat="server"><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Registro al encuentro académico</title><link href="Content/site.css" rel="stylesheet"/></head><body>
<main><header><p class="eyebrow">ENCUENTRO ACADÉMICO · REGISTRO DE ESTUDIANTES</p><h1>Un espacio para aprender<br/>y compartir ideas.</h1><p>Completa tu inscripción al encuentro académico.</p></header>
<form id="form1" runat="server"><div class="card"><div class="intro"><h2>Formulario de registro</h2><p>Los campos marcados con * son obligatorios.</p></div><asp:ValidationSummary ID="vsRegistro" runat="server" ValidationGroup="Registro" HeaderText="Revisa la siguiente información:" CssClass="summary"/><asp:Label ID="lblMensaje" runat="server" role="status" aria-live="polite"/>
<section><h2><span>01</span> Datos personales</h2><div class="grid"><div class="field"><asp:Label runat="server" AssociatedControlID="txtNombres" Text="Nombres *"/><asp:TextBox ID="txtNombres" runat="server" MaxLength="80" /><asp:RequiredFieldValidator ID="reqtxtNombres" runat="server" ControlToValidate="txtNombres" ErrorMessage="Nombres es obligatorio." Text="Nombres es obligatorio." ValidationGroup="Registro" CssClass="error" Display="Dynamic" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="txtApellidos" Text="Apellidos *"/><asp:TextBox ID="txtApellidos" runat="server" MaxLength="80" /><asp:RequiredFieldValidator ID="reqtxtApellidos" runat="server" ControlToValidate="txtApellidos" ErrorMessage="Apellidos es obligatorio." Text="Apellidos es obligatorio." ValidationGroup="Registro" CssClass="error" Display="Dynamic" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="txtCorreo" Text="Correo electrónico *"/><asp:TextBox ID="txtCorreo" runat="server" MaxLength="160" /><asp:RequiredFieldValidator ID="reqtxtCorreo" runat="server" ControlToValidate="txtCorreo" ErrorMessage="Correo electrónico es obligatorio." Text="Correo electrónico es obligatorio." ValidationGroup="Registro" CssClass="error" Display="Dynamic" /><asp:RegularExpressionValidator ID="revtxtCorreo" runat="server" ControlToValidate="txtCorreo" ValidationExpression="[^\s@]+@[^\s@]+\.[^\s@]+" ErrorMessage="Correo electrónico: formato inválido." ValidationGroup="Registro" CssClass="error" Display="Dynamic" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="txtTelefono" Text="Teléfono *"/><asp:TextBox ID="txtTelefono" runat="server" MaxLength="10" /><asp:RequiredFieldValidator ID="reqtxtTelefono" runat="server" ControlToValidate="txtTelefono" ErrorMessage="Teléfono es obligatorio." Text="Teléfono es obligatorio." ValidationGroup="Registro" CssClass="error" Display="Dynamic" /><asp:RegularExpressionValidator ID="revtxtTelefono" runat="server" ControlToValidate="txtTelefono" ValidationExpression="[0-9]{10}" ErrorMessage="Teléfono: formato inválido." ValidationGroup="Registro" CssClass="error" Display="Dynamic" /><small>10 dígitos, sin espacios. Ejemplo: 3001234567.</small></div></div></section><section><h2><span>02</span> Información académica</h2><div class="grid"><div class="field"><asp:Label runat="server" AssociatedControlID="ddlPrograma" Text="Programa académico *"/><asp:DropDownList ID="ddlPrograma" runat="server"/><asp:RequiredFieldValidator ID="reqddlPrograma" runat="server" ControlToValidate="ddlPrograma" ErrorMessage="Selecciona programa académico." Text="Selecciona programa académico." ValidationGroup="Registro" CssClass="error" Display="Dynamic" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="ddlSemestre" Text="Semestre *"/><asp:DropDownList ID="ddlSemestre" runat="server"/><asp:RequiredFieldValidator ID="reqddlSemestre" runat="server" ControlToValidate="ddlSemestre" ErrorMessage="Selecciona semestre." Text="Selecciona semestre." ValidationGroup="Registro" CssClass="error" Display="Dynamic" /></div></div></section><section><h2><span>03</span> Tu participación</h2><div class="grid"><fieldset><legend>Tipo de participación *</legend><asp:RadioButtonList ID="rblParticipacion" runat="server" CssClass="choices"/><asp:RequiredFieldValidator ID="reqrblParticipacion" runat="server" ControlToValidate="rblParticipacion" ErrorMessage="Selecciona el tipo de participación." Text="Selecciona el tipo de participación." ValidationGroup="Registro" CssClass="error" Display="Dynamic" /></fieldset><div class="field"><asp:Label runat="server" AssociatedControlID="ddlJornada" Text="Jornada *"/><asp:DropDownList ID="ddlJornada" runat="server"/><asp:RequiredFieldValidator ID="reqddlJornada" runat="server" ControlToValidate="ddlJornada" ErrorMessage="Selecciona jornada." Text="Selecciona jornada." ValidationGroup="Registro" CssClass="error" Display="Dynamic" /></div></div><fieldset class="topics"><legend>Temas de interés *</legend><small>Selecciona uno o varios temas.</small><asp:CheckBoxList ID="cblTemas" runat="server" RepeatLayout="Flow" CssClass="choices topics-list"/></fieldset></section>
<section><h2><span>04</span> Observaciones</h2><div class="field"><asp:Label runat="server" AssociatedControlID="txtComentarios" Text="Comentarios (opcional)"/><asp:TextBox ID="txtComentarios" runat="server" TextMode="MultiLine" Rows="3" MaxLength="500"/><small>Máximo 500 caracteres.</small></div></section>
<div class="consent"><asp:CheckBox ID="chkAcepta" runat="server" Text=" Acepto el tratamiento de mis datos para fines académicos. *"/></div><asp:CustomValidator ID="cvTemas" runat="server" OnServerValidate="ValidarServidor" ValidateEmptyText="true" ValidationGroup="Registro" ErrorMessage="Selecciona al menos un tema." CssClass="error" Display="Dynamic"/><asp:CustomValidator ID="cvAcepta" runat="server" OnServerValidate="ValidarServidor" ValidateEmptyText="true" ValidationGroup="Registro" ErrorMessage="Debes aceptar el tratamiento de datos." CssClass="error" Display="Dynamic"/><asp:CustomValidator ID="cvServidor" runat="server" OnServerValidate="ValidarServidor" ValidateEmptyText="true" ValidationGroup="Registro" ErrorMessage="Revisa los datos y la longitud de los comentarios." CssClass="error" Display="Dynamic"/><div class="actions"><asp:Button ID="btnRegistrar" runat="server" Text="Registrar" OnClick="btnRegistrar_Click" CssClass="primary" CausesValidation="true" ValidationGroup="Registro"/><asp:Button ID="btnLimpiar" runat="server" Text="Limpiar" OnClick="btnLimpiar_Click" CssClass="secondary" CausesValidation="false" ValidationGroup="Registro"/><asp:Button ID="btnCancelar" runat="server" Text="Cancelar" OnClick="btnCancelar_Click" CssClass="cancel" CausesValidation="false" ValidationGroup="Registro"/></div></div></form><footer>Proyecto de parcial · ASP.NET Web Forms y C#</footer></main></body></html>